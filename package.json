{
  "name": "react-native-inline-sheet",
  "version": "0.1.0",
  "description": "Instagram-style native bottom sheet for React Native (Fabric): the frame — present/dismiss, drag, detents, dim, scroll hand-off, keyboard — is UIKit / Android View code; the content is ordinary React. Inline mode lives in the screen's own layer, so a stack push slides over the open sheet and popping reveals it untouched.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "files": [
    "src",
    "android",
    "ios",
    "*.podspec",
    "README.md",
    "LICENSE",
    "!android/build",
    "!ios/build",
    "!**/__tests__",
    "!**/.*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "keywords": [
    "android",
    "bottom-sheet",
    "fabric",
    "ios",
    "modal",
    "native",
    "new-architecture",
    "react-native",
    "sheet"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramssutharr/react-native-inline-sheet.git"
  },
  "author": "Ram Suthar",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ramssutharr/react-native-inline-sheet/issues"
  },
  "homepage": "https://github.com/ramssutharr/react-native-inline-sheet#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.80.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "react": "19.1.0",
    "react-native": "0.83.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.69.0"
  },
  "codegenConfig": {
    "name": "RNBottomSheetNativeSpec",
    "type": "components",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.facebook.react.viewmanagers"
    },
    "ios": {
      "componentProvider": {
        "NativeBottomSheet": "NativeBottomSheet"
      }
    }
  }
}
